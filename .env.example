# Copia como .env.local. Nunca publiques este archivo con claves reales.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA
# Alternativa compatible: NEXT_PUBLIC_SUPABASE_ANON_KEY
# Exclusivamente servidor. NUNCA usar prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE
# Teléfono comercial con indicativo, solo números. Confirma el número de tu empresa.
NEXT_PUBLIC_WHATSAPP_PHONE=TU_NUMERO_CON_INDICATIVO
